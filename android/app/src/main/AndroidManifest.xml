<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Sign-in used to end in Chrome and stay there.

                 The Android build is a window onto pond.eend.app, so tapping
                 "continue with Google" leaves for accounts.google.com — which
                 it has to, because Google refuses OAuth inside an embedded
                 WebView. Google then redirects back to pond.eend.app, and
                 with nothing here claiming that address Chrome simply kept
                 it: the session landed in the browser and the app stayed
                 signed out, looking broken.

                 autoVerify sends Android to
                 https://pond.eend.app/.well-known/assetlinks.json on install
                 to check that the site agrees this app may handle its links.
                 That file lists the *Play app signing* certificates, not the
                 upload key — Play re-signs on the way out, so the upload
                 key's fingerprint would fail the check silently. Both the
                 classic and the post-quantum certificate are listed, because
                 either may be the one that signed what the device has. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pond.eend.app" />
            </intent-filter>

            <!-- Where a sign-in comes back to.
                 Not the App Link above, and the difference is the whole
                 reason "continue with Google" kept ending on the web site.
                 Android honours an App Link when it *dispatches* a URL — a
                 tapped link, a fresh load. The OAuth return is not that:
                 Google redirects to Supabase, Supabase redirects onward, all
                 inside one browser session that is already open, and Chrome
                 keeps the result of its own redirect chain however well
                 verified the domain is.
                 A scheme Chrome cannot render, it must hand on. No
                 verification, no dependence on how the navigation began.
                 The App Link filter above stays: it is still right for
                 somebody tapping a pond.eend.app link in a message, which is
                 a dispatch, and does work. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.eend.pond" android:host="auth" />
            </intent-filter>

        </activity>

        <!-- Where a location fix lands when the app isn't running. Not
             exported: the system delivers to it by explicit component, and
             nothing else has any business waking it. -->
        <receiver
            android:name=".VisitReceiver"
            android:exported="false" />

        <!-- A reboot cancels every PendingIntent location request on the
             device, silently, and the only symptom is a switch that still
             says "on" while nothing is ever recorded again. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13 made showing a notification a runtime permission, and a
         runtime permission that is not declared here cannot be granted: the
         request returns "denied" immediately, without a dialog and without an
         error. The Capacitor push plugin asks for this one by alias but never
         declares it, so on any modern phone the permission call has been
         failing silently since the day it was added. targetSdk is 36, so
         there is no legacy path that avoids it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Visit recording, all opt-in and all off until asked for in the app.
         Coarse is enough for "which town", and is what a phone with wifi
         positioning and no GPS fix will give; fine makes the stop radius
         mean something. Background is what lets a day nobody opened the app
         be recorded at all — the only days really worth recording.

         This APK is sideloaded from the project's own releases rather than
         published on Play, so the background permission needs no Play
         Console declaration or review. If it is ever published, that
         declaration becomes required. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
