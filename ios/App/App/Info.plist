<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Pond Hopping</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Only standard HTTPS/TLS is used (exempt encryption), so declare it
	     once here rather than answering the export-compliance question on
	     every TestFlight upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Visit monitoring only. No `location` background mode is declared:
	     CLVisit wakes the app on its own, and asking for continuous updates
	     would cost battery and invite an App Review question we'd have no
	     good answer to. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Pond Hopping notes the places you stop, so a trip fills in its own map and timeline while you get on with the holiday.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Pond Hopping builds your travel timeline in the background, so a day you never got round to opening the app still ends up in your journal.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Pond Hopping builds your travel timeline in the background, so a day you never got round to opening the app still ends up in your journal.</string>
	<!-- Push. `remote-notification` is what lets a notification arriving while
	     the app is backgrounded be handed to it at all; without it iOS shows
	     the banner and the app never hears about it, so the tap that should
	     open the Plan tab does nothing. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Where a sign-in comes back to.
	     Nothing on this side claimed app.eend.pond:// at all, so the redirect
	     that fixed Android would have dead-ended on iPhone in exactly the way
	     it dead-ended on Android: consent granted, browser holding the
	     session, app still signed out behind it.
	     Android registers the same scheme through an intent-filter in
	     AndroidManifest.xml. This is the other half, and Capacitor does not
	     add it — the appId is not a URL scheme until somebody says so.
	     Not Universal Links. Those need an apple-app-site-association served
	     from the domain and an associated-domains entitlement, and they carry
	     the same flaw the App Link did: they are honoured on a dispatch, not
	     on the end of a redirect chain inside an open browser. A scheme
	     Safari cannot render, it must hand on. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.eend.pond</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app.eend.pond</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
